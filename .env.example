# Application database (Better Auth, datasets metadata, jobs, audit).
DATABASE_URL="postgresql://datalize:datalize@localhost:5433/datalize"

# Analytical database. Same cluster in development, separate pool and
# statement_timeout at runtime. Split this out when workload justifies it.
ANALYTICAL_DATABASE_URL="postgresql://datalize:datalize@localhost:5433/datalize"

BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Social sign-in (docs/decisions/07). Optional: a provider whose credentials are
# absent is simply not offered in the UI, so a fresh clone works with email and
# password alone. Setting only one value of a pair is a configuration error and
# fails at boot rather than silently disabling the provider.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# S3-compatible object storage for raw uploads.
STORAGE_ENDPOINT=""
STORAGE_REGION=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# Trigger.dev. Set both to run jobs against the Trigger.dev dev runtime
# (`npx trigger.dev@latest dev`) — the production-like path. Omit
# TRIGGER_SECRET_KEY and jobs fall back to the in-process InlineDispatcher, a
# local convenience with no Trigger.dev project set up; it must never run a
# full-size (up to 50 MB / 1M row) import, the in-request failure mode
# Trigger.dev was adopted to avoid (adr/0001). Tests and CI always use
# InlineDispatcher and never read these variables.
TRIGGER_SECRET_KEY=""
TRIGGER_PROJECT_ID=""

# Optional in development, required before any external user.
SENTRY_DSN=""
