# Application database (Better Auth, datasets metadata, jobs, audit).
DATABASE_URL="postgresql://datalize:datalize@localhost:5433/datalize"

# Analytical database. Same cluster in development, separate pool and
# statement_timeout at runtime. Split this out when workload justifies it.
ANALYTICAL_DATABASE_URL="postgresql://datalize:datalize@localhost:5433/datalize"

BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Social sign-in (docs/decisions/07). Optional: a provider whose credentials are
# absent is simply not offered in the UI, so a fresh clone works with email and
# password alone. Setting only one value of a pair is a configuration error and
# fails at boot rather than silently disabling the provider.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# S3-compatible object storage for raw uploads (docker-compose.yml's `minio`
# service). Leave every STORAGE_* value unset and getStorageProvider()
# (src/modules/storage/index.ts) falls back to an in-memory provider whose
# upload URL no browser can PUT to — fine for `pnpm test`, not for actually
# uploading a file from the browser in dev. STORAGE_ENDPOINT must be
# host-visible (localhost, not the `minio` compose service name): the
# browser PUTs to it directly, from outside the compose network.
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="datalize-uploads"
STORAGE_ACCESS_KEY_ID="datalize"
STORAGE_SECRET_ACCESS_KEY="datalize-dev-secret"

# Trigger.dev. Set both to run jobs against the Trigger.dev dev runtime
# (`npx trigger.dev@latest dev`) — the production-like path. Omit
# TRIGGER_SECRET_KEY and jobs fall back to the in-process InlineDispatcher, a
# local convenience with no Trigger.dev project set up; it must never run a
# full-size (up to 50 MB / 1M row) import, the in-request failure mode
# Trigger.dev was adopted to avoid (adr/0001). Tests and CI always use
# InlineDispatcher and never read these variables.
TRIGGER_SECRET_KEY=""
TRIGGER_PROJECT_ID=""

# Optional in development, required before any external user.
SENTRY_DSN=""

# One-click sign-in as a seeded demo user at /api/dev/sign-in, for local
# development. It is not an authentication bypass: the route calls Better
# Auth's own signInEmail with a real password, so no second way to establish a
# session exists, and the request path gains no branch.
#
# Setting it with NODE_ENV=production fails at boot, by design. Put it in
# `.env.development.local` — which Next.js loads only for `next dev` — and NOT
# in `.env.local`, which `next build` reads too and which would therefore make
# your own production build refuse to start:
#
#     echo 'DEV_SIGN_IN="true"' >> .env.development.local
DEV_SIGN_IN=""
